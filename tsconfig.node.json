{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "src/mock/sampleData.ts", "src/types/game.ts"]
}
